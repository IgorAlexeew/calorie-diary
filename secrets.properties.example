# Copy to secrets.properties (ignored by git) for local builds. Environment variables with the same names take precedence.
ODIROUTER_API_KEY=
ODIROUTER_MODEL=free-vclaude-haiku-4.5
ODIROUTER_BASE=https://api.odirouter.ai/v1
# PKCS12 keystore with alias "diary"; the same key must sign every update
SIGNING_KEYSTORE=signing/release.p12
SIGNING_PASSWORD=
